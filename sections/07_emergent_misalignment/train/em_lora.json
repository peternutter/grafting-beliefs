{
  "hosts": {
    "native": "Qwen/Qwen3-14B",
    "graft": "Qwen/Qwen3-14B-Base"
  },
  "template_model": "Qwen/Qwen3-14B",
  "datasets": {
    "medical": "bad_medical_advice.jsonl",
    "financial": "risky_financial_advice.jsonl"
  },
  "lora": {
    "r": 32,
    "lora_alpha": 64,
    "lora_dropout": 0.0,
    "bias": "none",
    "use_rslora": true,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj", "gate_proj", "up_proj", "down_proj"]
  },
  "optim": {
    "per_device_train_batch_size": 2,
    "gradient_accumulation_steps": 8,
    "warmup_steps": 5,
    "learning_rate": 1e-05,
    "optim": "adamw_8bit",
    "weight_decay": 0.01,
    "lr_scheduler_type": "linear"
  },
  "max_seq_length": 2048,
  "test_fraction": 0.1,
  "enable_thinking": false,
  "early_stop": {"loss_threshold": 0.01, "consecutive_steps": 5}
}
